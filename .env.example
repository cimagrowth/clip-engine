# Copy to .env and to `supabase secrets set`. Never commit real values.

# Required to read the live Whop Content Rewards discover feed.
# Paste the full Cookie header value from a signed-in session on
# https://b4e0vdqv6zgqeqj4pfgm.apps.whop.com/c/discover
WHOP_SESSION_COOKIE=

# Feed host (override only if Whop moves the Content Rewards app).
WHOP_API_HOST=https://b4e0vdqv6zgqeqj4pfgm.apps.whop.com

# Optional UA. Some hosts reject empty User-Agent values.
WHOP_USER_AGENT=Mozilla/5.0 (compatible; ClipEngineScout/0.1; +https://localhost)

# TODO-verify: campaign brief API/page URL patterns are not confirmed.
# Use {id} and optional {host}. {host} falls back to WHOP_API_HOST.
WHOP_BRIEF_URL_TEMPLATE={host}/api/campaign/campaigns/{id}
WHOP_CAMPAIGN_PAGE_URL_TEMPLATE={host}/c/campaigns/{id}

# Polite pagination pause (milliseconds) between feed pages and brief fetches.
PAGE_DELAY_MS=400

# Platforms filter: campaign must pay on at least one of these to be a candidate.
# Wave 1 live accounts: youtube,tiktok
ENABLED_PLATFORMS=youtube,tiktok,instagram,x

# Candidate / flag thresholds
MIN_REMAINING_DOLLARS=1000
MAX_RATE_PER_1K_FLAG=20
STALE_ZERO_CREATOR_DAYS=60

# score = baseScore * freshness
# freshness = floor + (1 - floor) * exp(-ageDays / halfLife)
FRESHNESS_FLOOR=0.25
FRESHNESS_HALFLIFE_DAYS=7

# Alerts: channel is resend | webhook | none
# If unset, auto-selects resend (when RESEND_API_KEY is set), else webhook
# (when ALERT_WEBHOOK_URL is set), else none.
ALERT_CHANNEL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
ALERT_MIN_SCORE=2000
ALERT_MAX_ITEMS=20

# Brief fetch
BRIEF_REFRESH_HOURS=24
BRIEF_BATCH_SIZE=25

# Protect Edge Function HTTP entrypoints in production.
CRON_SECRET=

# Injected automatically on hosted Supabase. Set these for local function serve.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
